# Safe placeholders only. Copy to .env for local runs. Never commit .env.

PORT=3000
CUSTOMER_SITE_PORT=8080
DATABASE_URL=postgres://widget:widget@localhost:5432/widget_platform
JWT_SECRET=replace-with-a-long-random-string

# Public origin used inside the embed snippet.
WIDGET_PUBLIC_BASE_URL=http://localhost:3000
WIDGET_ASSET_VERSION=v1

# Geo provider A, then provider B. No API keys. No credit card.
GEO_PROVIDER_A_URL=http://ip-api.com
GEO_PROVIDER_B_URL=https://ipapi.co
# live uses the free APIs. mock is required for the fallback proof.
GEO_MODE=mock
GEO_MOCK_A_DOWN=false
GEO_MOCK_B_DOWN=false

# console logs the side effect. smtp sends it to local Mailpit.
EMAIL_MODE=console
SMTP_HOST=localhost
SMTP_PORT=1025
# When true, the email or webhook job throws. The submission must still succeed.
SIDE_EFFECT_FORCE_FAIL=false

# Burst limits. Both are required: per IP and per widget.
RATE_LIMIT_IP_MAX=30
RATE_LIMIT_IP_WINDOW_MS=60000
RATE_LIMIT_WIDGET_MAX=60
RATE_LIMIT_WIDGET_WINDOW_MS=60000
